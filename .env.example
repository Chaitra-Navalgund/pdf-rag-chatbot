# ============================================================
# PDF RAG Chatbot — Environment Configuration
# ============================================================
# Copy this file to .env and replace placeholder values.
# NEVER commit your real .env file to version control.
# ============================================================

# --- Flask ---
FLASK_SECRET_KEY=your-random-secret-key-change-this
FLASK_ENV=development
FLASK_DEBUG=True

# --- LLM Provider (choose ONE) ---
# Option 1: Google Gemini (FREE tier available — recommended for students)
#   Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Option 2: OpenAI GPT (paid — optional)
#   Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# --- LLM Configuration ---
# Which provider to use: "gemini" or "openai"
LLM_PROVIDER=gemini
# Model name (gemini: "gemini-3.8-flash", openai: "gpt-3.5-turbo")
LLM_MODEL=gemini-3.8-flash

# --- File Upload ---
# Maximum upload size in bytes (default: 50 MB)
MAX_CONTENT_LENGTH=52428800
# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=pdf

# --- RAG Pipeline ---
# Sentence Transformer model for embeddings (downloads on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Chunk size in characters
CHUNK_SIZE=1000
# Overlap between consecutive chunks in characters
CHUNK_OVERLAP=200
# Number of top chunks to retrieve per query
TOP_K_RESULTS=5

# --- Database ---
DATABASE_PATH=database/chatbot.db

# --- Uploads ---
UPLOAD_FOLDER=uploads
